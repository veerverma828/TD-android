<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared by the module rather than app.json/the generated manifest because
         /android is gitignored and regenerated by `expo prebuild` - a permission added
         there disappears on the next clean build. Library manifests get merged into the
         app, so this survives. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by NetworkProbe to tell "device is offline" apart from "this network
         blocks P2P traffic", which are the two failure modes users most often confuse. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeps the swarm connections alive while the screen is off during playback. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

</manifest>
